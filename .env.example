# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scalara_radar
POSTGRES_USER=scalara
POSTGRES_PASSWORD=scalara_dev_password
DATABASE_URL=postgresql://scalara:scalara_dev_password@localhost:5432/scalara_radar

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
