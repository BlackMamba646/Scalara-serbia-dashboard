# PostgreSQL — same database as the workers
# For Vercel + Neon: postgresql://user:pass@host:port/dbname?sslmode=require
# Note: Vercel (Node.js) uses the standard postgres:// prefix, NOT asyncpg
DATABASE_URL=postgresql://scalara:scalara_dev_password@localhost:5432/scalara_radar

NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_PASSWORD=changeme

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
