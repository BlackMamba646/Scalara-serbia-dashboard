# PostgreSQL — use the connection string from Railway/Render/Neon
# For Railway: postgresql+asyncpg://user:pass@host:port/dbname
# IMPORTANT: must use asyncpg driver prefix for SQLAlchemy async
DATABASE_URL=postgresql+asyncpg://scalara:scalara_dev_password@localhost:5432/scalara_radar

# Redis — use the connection string from Railway/Upstash
REDIS_URL=redis://localhost:6379

# Frontend URL for CORS (your Vercel deployment)
FRONTEND_URL=https://your-app.vercel.app

# LLM API key (Anthropic) — optional, used for AI signal enrichment
LLM_API_KEY=

# Port (Railway sets this automatically)
PORT=8000
